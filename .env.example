# Online database (Supabase). Copy this file to .env.local and fill in the two values
# from Supabase -> Project Settings -> API. The anon key is meant to be public.
# On Netlify, add the same two as Site configuration -> Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
